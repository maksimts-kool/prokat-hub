{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.Hosting.Lifetime": "Information",
        "Polly": "Error",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:u} {Level:u3} {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Api": {
    "BaseUrl": "http://localhost:8080",
    "Email": "service@prokathub.test",
    "Password": ""
  },
  "Overdue": {
    "Interval": "01:00:00",
    "RunOnStartup": true
  },
  "Resilience": {
    "TotalRequestTimeout": { "Timeout": "00:03:00" },
    "Retry": {
      "MaxRetryAttempts": 6,
      "BackoffType": "Exponential",
      "UseJitter": true,
      "Delay": "00:00:02",
      "MaxDelay": "00:00:30"
    },
    "AttemptTimeout": { "Timeout": "00:00:10" }
  }
}
