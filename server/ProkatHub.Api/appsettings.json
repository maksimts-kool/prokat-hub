{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:u} {Level:u3} {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Jwt": {
    "Issuer": "prokat-hub-api",
    "Audience": "prokat-hub",
    "SigningKey": "",
    "ExpiresMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Seed": {
    "DemoData": false,
    "Accounts": {
      "Admin": { "Email": "admin@prokathub.test", "FullName": "Anna Admin" },
      "Staff": { "Email": "staff@prokathub.test", "FullName": "Sander Staff" },
      "Customer": { "Email": "customer@prokathub.test", "FullName": "Kristi Customer" },
      "Service": { "Email": "service@prokathub.test", "FullName": "Overdue Worker" }
    }
  }
}
