{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss ",
        "UseUtcTimestamp": true
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Jwt": {
    "Issuer": "prokat-hub-api",
    "Audience": "prokat-hub",
    "SigningKey": "",
    "ExpiresMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Seed": {
    "DemoData": false,
    "Accounts": {
      "Admin": { "Email": "admin@prokathub.test", "FullName": "Anna Admin" },
      "Staff": { "Email": "staff@prokathub.test", "FullName": "Sander Staff" },
      "Customer": { "Email": "customer@prokathub.test", "FullName": "Kristi Customer" },
      "Service": { "Email": "service@prokathub.test", "FullName": "Overdue Worker" }
    }
  }
}
