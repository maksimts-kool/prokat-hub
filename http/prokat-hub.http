# Requests for the Prokat Hub API.
# Works with the VS Code REST Client extension, Visual Studio and JetBrains Rider.
# Passwords are the SEED_*_PASSWORD values from your .env file.
#
# Run the requests from top to bottom: each "Log in as …" request fills its role's token
# variable below, and later requests reuse the rental, category and item created earlier.
# The expected status code is in each request's title.

@baseUrl = http://localhost:8080
@customerEmail = customer@prokathub.test
@customerPassword = Customer12345
@staffEmail = staff@prokathub.test
@staffPassword = Staff12345
@adminEmail = admin@prokathub.test
@adminPassword = Admin12345
@serviceEmail = service@prokathub.test
@servicePassword = Service12345
# Set today to today's date (UTC). From and to must not be in the past.
@today = 2026-11-26
@from = 2027-01-11
@to = 2027-01-17

# Bearer tokens, filled in by the login requests (customerLogin, staffLogin, serviceLogin, adminLogin).
@customerToken = {{customerLogin.response.body.$.accessToken}}
@staffToken = {{staffLogin.response.body.$.accessToken}}
@serviceToken = {{serviceLogin.response.body.$.accessToken}}
@adminToken = {{adminLogin.response.body.$.accessToken}}

### Health check
GET {{baseUrl}}/health

### Categories
GET {{baseUrl}}/api/categories

### Item catalogue, page 1
GET {{baseUrl}}/api/items?page=1&pageSize=12

### Search by name, brand or description
GET {{baseUrl}}/api/items?search=sony

### Cameras, most expensive first
GET {{baseUrl}}/api/items?categoryId=1&sort=price_desc

### Daily price between 20 € and 40 €, cheapest first
GET {{baseUrl}}/api/items?minPrice=20&maxPrice=40&sort=price

### Most rented items first
GET {{baseUrl}}/api/items?sort=popularity&pageSize=5

### Catalogue for a week: each item's isAvailable says whether it is free on those days
GET {{baseUrl}}/api/items?from=2026-12-07&to=2026-12-13

### From without To → 400 ValidationProblemDetails
GET {{baseUrl}}/api/items?from=2026-12-07

### Unknown sort value → 400 ValidationProblemDetails
GET {{baseUrl}}/api/items?sort=rating

### minPrice above maxPrice → 400 ValidationProblemDetails
GET {{baseUrl}}/api/items?minPrice=50&maxPrice=10

### One item
GET {{baseUrl}}/api/items/1

### Unknown item → 404 ProblemDetails
GET {{baseUrl}}/api/items/99999

### Availability of an item for a date range
GET {{baseUrl}}/api/items/1/availability?from={{from}}&to={{to}}

### Availability with from after to → 400 ValidationProblemDetails
GET {{baseUrl}}/api/items/1/availability?from={{to}}&to={{from}}

### Availability for a range in the past → 400 ValidationProblemDetails
GET {{baseUrl}}/api/items/1/availability?from=2020-01-01&to=2020-01-05

### Rental quote: days, daily price, subtotal, discount, deposit and total
GET {{baseUrl}}/api/rentals/quote?itemId=1&from={{from}}&to={{to}}

### Rental quote for one day → no discount
GET {{baseUrl}}/api/rentals/quote?itemId=1&from={{from}}&to={{from}}

### Rental quote without itemId → 400 ValidationProblemDetails
GET {{baseUrl}}/api/rentals/quote?from={{from}}&to={{to}}

### Rental quote for an unknown item → 404 ProblemDetails
GET {{baseUrl}}/api/rentals/quote?itemId=99999&from={{from}}&to={{to}}

### Register a new customer → 201 ($timestamp keeps the email unique on every run)
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "new.customer.{{$timestamp}}@example.com",
  "password": "Password123",
  "fullName": "New Customer"
}

### Log in as the seeded customer
# @name customerLogin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{customerEmail}}",
  "password": "{{customerPassword}}"
}

### Wrong password → 401
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{customerEmail}}",
  "password": "wrong-password"
}

### Current user
GET {{baseUrl}}/api/auth/me
Authorization: Bearer {{customerToken}}

### Book an item (Customer) → 201 with the rental; the price is calculated on the server
# @name newRental
POST {{baseUrl}}/api/rentals
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "itemId": 2,
  "from": "{{from}}",
  "to": "{{to}}"
}

### Book the same item for overlapping days → 409 ProblemDetails
POST {{baseUrl}}/api/rentals
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "itemId": 2,
  "from": "{{to}}",
  "to": "{{to}}"
}

### Book without dates → 400 ValidationProblemDetails
POST {{baseUrl}}/api/rentals
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "itemId": 2
}

### Book an unknown item → 404 ProblemDetails
POST {{baseUrl}}/api/rentals
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "itemId": 99999,
  "from": "{{from}}",
  "to": "{{to}}"
}

### My rentals (Customer) → 200
GET {{baseUrl}}/api/rentals/my
Authorization: Bearer {{customerToken}}

### My rentals without a token → 401
GET {{baseUrl}}/api/rentals/my

### Log in as staff
# @name staffLogin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{staffEmail}}",
  "password": "{{staffPassword}}"
}

### My rentals with a Staff token → 403
GET {{baseUrl}}/api/rentals/my
Authorization: Bearer {{staffToken}}

### All rentals (Staff) → 200, one page, newest first
GET {{baseUrl}}/api/rentals?page=1&pageSize=20
Authorization: Bearer {{staffToken}}

### Rentals at the desk: Issued or Overdue
GET {{baseUrl}}/api/rentals?status=Issued&status=Overdue
Authorization: Bearer {{staffToken}}

### Booked rentals that cover some day of a range
GET {{baseUrl}}/api/rentals?status=Booked&from={{from}}&to={{to}}
Authorization: Bearer {{staffToken}}

### Unknown status filter → 400 ValidationProblemDetails
GET {{baseUrl}}/api/rentals?status=Lost
Authorization: Bearer {{staffToken}}

### All rentals with a Customer token → 403
GET {{baseUrl}}/api/rentals
Authorization: Bearer {{customerToken}}

### Customer tries to issue their own rental → 403 ProblemDetails (staff only)
PATCH {{baseUrl}}/api/rentals/{{newRental.response.body.$.id}}/status
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "status": "Issued"
}

### Staff issues a rental before its start date → 409 ProblemDetails
PATCH {{baseUrl}}/api/rentals/{{newRental.response.body.$.id}}/status
Authorization: Bearer {{staffToken}}
Content-Type: application/json

{
  "status": "Issued"
}

### Booked → Returned is not a valid change → 409 ProblemDetails
PATCH {{baseUrl}}/api/rentals/{{newRental.response.body.$.id}}/status
Authorization: Bearer {{staffToken}}
Content-Type: application/json

{
  "status": "Returned"
}

### Status missing → 400 ValidationProblemDetails
PATCH {{baseUrl}}/api/rentals/{{newRental.response.body.$.id}}/status
Authorization: Bearer {{staffToken}}
Content-Type: application/json

{
  "note": "No status"
}

### Unknown rental → 404 ProblemDetails
PATCH {{baseUrl}}/api/rentals/99999/status
Authorization: Bearer {{staffToken}}
Content-Type: application/json

{
  "status": "Cancelled"
}

### Customer cancels their booking → 200 with status Cancelled
PATCH {{baseUrl}}/api/rentals/{{newRental.response.body.$.id}}/status
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "status": "Cancelled",
  "note": "Plans changed"
}

### Cancel it again → 409 ProblemDetails
PATCH {{baseUrl}}/api/rentals/{{newRental.response.body.$.id}}/status
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "status": "Cancelled"
}

### Book an item for today (Customer) → 201, so staff can issue it
# @name todayRental
POST {{baseUrl}}/api/rentals
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "itemId": 4,
  "from": "{{today}}",
  "to": "{{today}}"
}

### Staff issues it at the desk → 200 with status Issued and issuedAt
PATCH {{baseUrl}}/api/rentals/{{todayRental.response.body.$.id}}/status
Authorization: Bearer {{staffToken}}
Content-Type: application/json

{
  "status": "Issued",
  "note": "ID checked, deposit taken"
}

### Customer cancels an issued rental → 409 ProblemDetails
PATCH {{baseUrl}}/api/rentals/{{todayRental.response.body.$.id}}/status
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "status": "Cancelled"
}

### Staff takes it back on time → 200 with status Returned and lateFeeTotal 0
PATCH {{baseUrl}}/api/rentals/{{todayRental.response.body.$.id}}/status
Authorization: Bearer {{staffToken}}
Content-Type: application/json

{
  "status": "Returned"
}

### Log in as the Service account (used by the overdue worker)
# @name serviceLogin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{serviceEmail}}",
  "password": "{{servicePassword}}"
}

### Overdue rentals (Service) → 200, Issued or Overdue past their end date, oldest first
# @name overdue
GET {{baseUrl}}/api/rentals/overdue
Authorization: Bearer {{serviceToken}}

### Overdue rentals (Staff) → 200
GET {{baseUrl}}/api/rentals/overdue
Authorization: Bearer {{staffToken}}

### Overdue rentals with a Customer token → 403
GET {{baseUrl}}/api/rentals/overdue
Authorization: Bearer {{customerToken}}

### Overdue rentals without a token → 401
GET {{baseUrl}}/api/rentals/overdue

### Mark the first overdue rental late → 200, status Overdue, lateDays × lateFeePerDay = lateFeeTotal
# Needs at least one rental in the overdue list.
POST {{baseUrl}}/api/rentals/{{overdue.response.body.$[0].id}}/mark-late
Authorization: Bearer {{serviceToken}}

### Mark it late again → 200 with the same fee (days are never charged twice)
POST {{baseUrl}}/api/rentals/{{overdue.response.body.$[0].id}}/mark-late
Authorization: Bearer {{serviceToken}}

### Mark late the booking cancelled above (not Issued or Overdue) → 409 ProblemDetails
POST {{baseUrl}}/api/rentals/{{newRental.response.body.$.id}}/mark-late
Authorization: Bearer {{serviceToken}}

### Mark late an unknown rental → 404 ProblemDetails
POST {{baseUrl}}/api/rentals/99999/mark-late
Authorization: Bearer {{serviceToken}}

### Mark late with a Customer token → 403
POST {{baseUrl}}/api/rentals/{{newRental.response.body.$.id}}/mark-late
Authorization: Bearer {{customerToken}}

### Log in as admin
# @name adminLogin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

### Create a category (Admin) → 201 with Location; the slug is made from the name ($timestamp keeps it unique)
# @name newCategory
POST {{baseUrl}}/api/categories
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "3D Printers {{$timestamp}}",
  "description": "FDM and resin printers."
}

### Create a category with a name in use → 409, with the message under errors.Name
POST {{baseUrl}}/api/categories
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Cameras"
}

### Create a category as customer → 403
POST {{baseUrl}}/api/categories
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "name": "Printers"
}

### Change the category description (Admin) → 200
PUT {{baseUrl}}/api/categories/{{newCategory.response.body.$.id}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "{{newCategory.response.body.$.name}}",
  "slug": "{{newCategory.response.body.$.slug}}",
  "description": "FDM and resin printers, filament included."
}

### Create an item (Admin) → 201 with Location
# @name newItem
POST {{baseUrl}}/api/items
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "categoryId": {{newCategory.response.body.$.id}},
  "name": "Bambu Lab P1S",
  "brand": "Bambu Lab",
  "description": "Enclosed 3D printer for PLA, PETG and ABS.",
  "imageUrl": "https://placehold.co/640x480/png?text=Bambu%20Lab%20P1S",
  "dailyPrice": 25,
  "deposit": 400,
  "lateFeePerDay": 37.5
}

### Create an item with invalid fields → 400 ValidationProblemDetails
POST {{baseUrl}}/api/items
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "categoryId": 99999,
  "name": "X",
  "dailyPrice": 0
}

### Update an item (Admin)
PUT {{baseUrl}}/api/items/{{newItem.response.body.$.id}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "categoryId": {{newCategory.response.body.$.id}},
  "name": "Bambu Lab P1S Combo",
  "brand": "Bambu Lab",
  "description": "Enclosed 3D printer with the AMS for multi-colour prints.",
  "imageUrl": null,
  "dailyPrice": 30,
  "deposit": 450,
  "lateFeePerDay": 45
}

### Delete a category that still has items → 409
DELETE {{baseUrl}}/api/categories/{{newCategory.response.body.$.id}}
Authorization: Bearer {{adminToken}}

### Retire an item (Admin) → 204; it leaves the catalogue but stays in rental history
DELETE {{baseUrl}}/api/items/{{newItem.response.body.$.id}}
Authorization: Bearer {{adminToken}}

### Retire an item with open rentals → 409
DELETE {{baseUrl}}/api/items/1
Authorization: Bearer {{adminToken}}

### Unknown item → 404
PUT {{baseUrl}}/api/items/99999
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "categoryId": 1,
  "name": "Nothing",
  "brand": "None",
  "description": "Does not exist.",
  "dailyPrice": 10,
  "deposit": 0,
  "lateFeePerDay": 0
}

### Popular items, all time (Admin) → 200, most rentals first, with revenue including late fees
GET {{baseUrl}}/api/reports/popular-items?top=5
Authorization: Bearer {{adminToken}}

### Popular items for November (Admin) → 200; rentals that start in the range count
GET {{baseUrl}}/api/reports/popular-items?from=2026-11-01&to=2026-11-30&top=10
Authorization: Bearer {{adminToken}}

### Popular items with only one date → 400 ValidationProblemDetails
GET {{baseUrl}}/api/reports/popular-items?from=2026-11-01
Authorization: Bearer {{adminToken}}

### Popular items as customer → 403
GET {{baseUrl}}/api/reports/popular-items
Authorization: Bearer {{customerToken}}
