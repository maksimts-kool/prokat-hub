# Copy this file to .env (git-ignored): cp .env.example .env
# These are local development values. Change every secret before deploying anywhere public.

# --- PostgreSQL ---
POSTGRES_DB=prokathub
POSTGRES_USER=prokathub
POSTGRES_PASSWORD=prokathub-dev-password
POSTGRES_PORT=5432

# --- API ---
API_PORT=8080
# dev = dotnet watch with hot reload (use `docker compose watch`), final = slim ASP.NET runtime image
API_BUILD_TARGET=dev
ASPNETCORE_ENVIRONMENT=Development
# Origin of the React dev server, allowed by CORS
CLIENT_ORIGIN=http://localhost:5173

# --- JWT ---
# At least 32 characters. Generate a new one with: openssl rand -base64 48
JWT_SIGNING_KEY=dev-only-signing-key-please-replace-with-openssl-rand-base64-48

# --- Seeded role accounts ---
# One account per role is created at startup when its password is set (leave empty to skip).
# Passwords need 8+ characters with upper case, lower case and a digit.
SEED_ADMIN_PASSWORD=Admin12345
SEED_STAFF_PASSWORD=Staff12345
SEED_CUSTOMER_PASSWORD=Customer12345
SEED_SERVICE_PASSWORD=Service12345
