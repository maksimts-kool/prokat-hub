# Copy this file to .env (git-ignored): cp .env.example .env
# These are local development values. Change every secret before deploying anywhere public.
#
# Start everything:            docker compose up --build
# Develop with hot reload:     docker compose watch
# Production-like images:      set API_BUILD_TARGET=final, WEB_BUILD_TARGET=final and
#                              ASPNETCORE_ENVIRONMENT=Production, then docker compose up --build

# --- MariaDB ---
DB_NAME=prokathub
DB_USER=prokathub
DB_PASSWORD=prokathub-dev-password
DB_ROOT_PASSWORD=prokathub-dev-password-root
DB_PORT=3306
# MariaDB version the API generates SQL for (Database:ServerVersion); keep it at or below the server's version.
DB_SERVER_VERSION=10.11
# Apply EF Core migrations on API start, and seed the demo catalogue and rentals (both idempotent).
DB_MIGRATE_ON_STARTUP=true
SEED_DEMO_DATA=true

# --- API ---
API_PORT=8080
# dev = dotnet watch with hot reload (use `docker compose watch`), final = slim ASP.NET runtime image
API_BUILD_TARGET=dev
ASPNETCORE_ENVIRONMENT=Development
# Origin of the React dev server, allowed by CORS
CLIENT_ORIGIN=http://localhost:5173

# --- Web client ---
# Keep WEB_PORT in sync with CLIENT_ORIGIN, and VITE_API_URL with API_PORT.
WEB_PORT=5173
# dev = Vite dev server with hot reload (use `docker compose watch`), final = built client on nginx
WEB_BUILD_TARGET=dev
VITE_API_URL=http://localhost:8080

# --- JWT ---
# At least 32 characters. Generate a new one with: openssl rand -base64 48
JWT_SIGNING_KEY=dev-only-signing-key-please-replace-with-openssl-rand-base64-48

# --- Seeded role accounts ---
# One account per role is created at startup when its password is set (leave empty to skip).
# The Service account is required: the worker logs in with it.
# Passwords need 8+ characters with upper case, lower case and a digit.
SEED_ADMIN_PASSWORD=Admin12345
SEED_STAFF_PASSWORD=Staff12345
SEED_CUSTOMER_PASSWORD=Customer12345
SEED_SERVICE_PASSWORD=Service12345

# --- Worker ---
# The worker logs in to the API as the Service account above (SEED_SERVICE_PASSWORD).
SERVICE_EMAIL=service@prokathub.test
# Time between overdue runs (hh:mm:ss); it also runs once at startup.
WORKER_INTERVAL=01:00:00
