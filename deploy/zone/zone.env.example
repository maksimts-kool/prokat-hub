# Settings for deploy/zone/deploy.sh. Copy to deploy/zone/zone.env (git-ignored) and fill in.
# Secrets are NOT kept here: the first deploy generates them on the server (see deploy.sh).

# SSH host as in ~/.ssh/config (user and key come from there).
ZONE_SSH=example.thkit.ee
# Public origin of the site and the path the app is served under.
SITE_ORIGIN=https://example.thkit.ee
BASE_PATH=/prokathub
# Loopback IP Zone assigns to the account (the one existing PM2 apps listen on) and a free port for the API.
APP_IP=127.0.0.1
APP_PORT=3230
# Home directory on the server; the app goes to $REMOTE_HOME/prokathub.
REMOTE_HOME=/data01/virtXXXXXX
# Document root of the site; the proxy .htaccess goes to $WEB_ROOT$BASE_PATH.
WEB_ROOT=/data01/virtXXXXXX/domeenid/www.example.thkit.ee/htdocs

# MariaDB from MyZone. The password is typed into the server's PM2 file, not here.
DB_HOST=dXXXXXX.mysql.zonevs.eu
DB_NAME=dXXXXXX_prokathub
DB_USER=dXXXXXX_prokathub
# MariaDB version the API writes SQL for; keep it at or below the server's version.
DB_SERVER_VERSION=10.11
